{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@inlens/core": ["./packages/core/src/index.ts"],
      "@inlens/core/internal/geometry": ["./packages/core/src/internal/geometry.ts"],
      "@inlens/react": ["./packages/react/src/index.ts"],
      "@inlens/next": ["./packages/next/src/index.ts"]
    }
  }
}
