{
  "name": "@inlens/react",
  "version": "0.1.0",
  "description": "Production-quality compound React image magnifier components",
  "keywords": [
    "compound-components",
    "image-magnifier",
    "magnifier",
    "react",
    "react-server-components",
    "zoom"
  ],
  "homepage": "https://github.com/kamst01/inlens#readme",
  "bugs": {
    "url": "https://github.com/kamst01/inlens/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamst01/inlens.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts ../../packages/react/src/__tests__"
  },
  "dependencies": {
    "@inlens/core": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20.0.0",
    "react-dom": ">=18.3.0 <20.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
